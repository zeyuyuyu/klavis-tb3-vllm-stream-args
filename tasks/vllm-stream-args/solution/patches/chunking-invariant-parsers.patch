+
+    def _at_call_level(self) -> bool:
+        return self.call_depth is not None and self.depth == self.call_depth
+
+    def _key_starts_arguments(self) -> bool:
+        if self.pending_key is None or self.prev != ":":
+            return False
+        if self.pending_key in self.argument_keys:
+            return True
+        if self.name_is_key and self.calls and self.calls[-1]["name"] is None:
+            self.calls[-1]["name"] = self.pending_key
