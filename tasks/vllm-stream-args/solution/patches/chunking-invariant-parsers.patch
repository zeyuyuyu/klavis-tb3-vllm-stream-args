+# --- chunking-invariant streaming support -------------------------------------
+#
+# ``StreamingToolCallScanner`` lets a parser stream the arguments of JSON tool
+# calls so that the client-side concatenation of every delta is exactly
+# ``json.dumps(json.loads(raw), ensure_ascii=False)`` whatever way the model
+# output was split into deltas, while each delta still goes out as soon as the
+# text that determines it has arrived.  It works on the raw model text, never
+# on a re-parsed and re-serialised snapshot, so nothing already sent can change
+# afterwards, and it resumes where it stopped, so a stream costs O(len) in
+# total rather than O(len) per delta.
+
+_JSON_WS = " \t\n\r"
+_NUM_CHARS = frozenset("+-0123456789.eE")
+_LITERALS = {"true": True, "false": False, "null": None}
+_SIMPLE_ESCAPES = {"n": "\n", "t": "\t", "r": "\r", "b": "\b", "f": "\f"}
+
+
+def _escape_string_body(value: str) -> str:
+    return json.dumps(value, ensure_ascii=False)[1:-1]
+
+
+class StreamingToolCallScanner:
+    """Incremental scanner over the JSON payload of a tool-call stream.
+
+    ``feed(text, end)`` is given the payload text seen so far (append-only; the
+    scanner only reads ``text[self.pos:end]``).  For each tool call found so
+    far it keeps the ``name`` once its string is complete and an append-only
+    list of canonical ``args`` chunks: the canonical rendering of the arguments
+    value as far as it is determined.  Unfinished strings are rendered up to
+    the last character that can no longer change (an incomplete escape or a
+    high surrogate waiting for its partner is held back), numbers wait for the
+    character that terminates them, object keys wait for their closing quote.
+    The payload may be one call object or an array of them.
+    """
+
+    def __init__(
+        self,
+        argument_keys=("arguments",),
+        *,
+        name_is_key: bool = False,
+        root_arguments: bool = False,
+        start_in_array: bool = False,
+        ensure_ascii: bool = False,
+    ):
+        self.argument_keys = tuple(argument_keys)
+        self.name_is_key = name_is_key  # {"tool_name": {...args...}} objects
+        self.ensure_ascii = ensure_ascii
+        self.calls: list[dict] = []
+        self.pos = 0
+        self.depth = 1 if start_in_array else 0
+        self.done = False
+        self.broken = False
+        self.call_depth: int | None = None
+        self.pending_key: str | None = None
+        self.prev = None  # previous structural event: '{' '[' ',' ':' 'key' 'value'
+        self.render = False
+        self.arg_depth: int | None = None
+        self.frames: list[list] = []  # [kind, items, expecting_key]
+        self.mode: str | None = None  # None | 'str' | 'num' | 'lit'
+        self.str_key = False
+        self.str_buf: list[str] = []
+        self.esc = ""
+        self.hi: int | None = None
+        self.buf = ""
+        if root_arguments:
+            # The whole payload is one call's arguments value (name known
+            # from elsewhere): render from the first character.
+            self.call_depth = 0
+            self._new_call()
+            self.render = True
+            self.arg_depth = 0
+            self.calls[-1]["args_started"] = True
+
+    # -- public ---------------------------------------------------------------
+    def feed(self, text: str, end: int | None = None) -> None:
+        if self.done or self.broken:
+            return
+        i = self.pos
+        n = len(text) if end is None else end
+        while i < n:
+            if self.mode == "str":
+                i = self._feed_string(text, i, n)
+                continue
+            c = text[i]
+            if self.mode == "num":
+                if c in _NUM_CHARS:
+                    self.buf += c
+                    i += 1
+                    continue
+                self._end_number()
+                continue
+            if self.mode == "lit":
+                self.buf += c
+                i += 1
+                if self.buf in _LITERALS:
+                    self._end_literal()
+                elif not any(w.startswith(self.buf) for w in _LITERALS):
+                    self.broken = True
+                    break
+                continue
+            if c in _JSON_WS:
+                i += 1
+            elif c == "{" or c == "[":
+                self._open(c)
+                i += 1
+            elif c == "}" or c == "]":
+                self._close(c)
+                i += 1
+                if self.done:
+                    break
+            elif c == ",":
+                if self.render and self.frames and self.frames[-1][0] == "{":
+                    self.frames[-1][2] = True
+                self.prev = ","
+                i += 1
+            elif c == ":":
+                self.prev = ":"
+                i += 1
+            elif c == '"':
+                self._begin_string()
+                i += 1
+            elif c in "-0123456789":
