+def canonical_json_prefix(text: str) -> str:
+    """Canonical rendering of the (possibly unfinished) JSON value in ``text``.
+
+    For every prefix ``p`` of a valid JSON document ``t`` the result for ``p``
+    is a prefix of the result for ``t``, and the result for ``t`` equals
+    ``json.dumps(json.loads(t), ensure_ascii=False)``.
+    """
+    scanner = StreamingToolCallScanner(("value",))
+    scanner.feed('{"value":' + text)
+    if not scanner.calls:
+        return ""
+    return "".join(scanner.calls[0]["args"])
+
