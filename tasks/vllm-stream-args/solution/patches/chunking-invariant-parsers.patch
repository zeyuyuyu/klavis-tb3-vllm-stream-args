+            self.frames.append([c, 0, c == "{"])
+        elif c == "{" and self.call_depth is None and self.depth <= 2:
+            self.call_depth = self.depth
+            self._new_call()
+        elif (
+            self.call_depth is not None
+            and self.depth == self.call_depth + 1
+            and self._key_starts_arguments()
+        ):
+            self.render = True
+            self.arg_depth = self.depth - 1
+            self.frames = [[c, 0, c == "{"]]
+            self.calls[-1]["args_started"] = True
+            self.pending_key = None
+            self._out(c)
+        elif self.call_depth is not None and self.depth == self.call_depth + 1:
+            self.pending_key = None
+        self.prev = c
+
+    def _close(self, c: str) -> None:
