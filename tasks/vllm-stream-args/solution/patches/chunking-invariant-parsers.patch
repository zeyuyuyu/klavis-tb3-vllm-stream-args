+            deltas.append(
+                DeltaToolCall(
+                    index=idx,
+                    function=DeltaFunctionCall(arguments=fragment).model_dump(
+                        exclude_none=True
+                    ),
+                )
+            )
+    if not deltas and content is None:
+        return None
+    return DeltaMessage(content=content, tool_calls=deltas)
