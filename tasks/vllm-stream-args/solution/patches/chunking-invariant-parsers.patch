+    # -- structure ------------------------------------------------------------
+    def _new_call(self) -> None:
+        self.calls.append(
+            {"name": None, "args": [], "args_started": False, "args_done": False, "done": False}
+        )
+
+    def _out(self, s: str) -> None:
+        self.calls[-1]["args"].append(s)
+
+    def _dumps(self, value) -> str:
+        return json.dumps(value, ensure_ascii=self.ensure_ascii)
+
+    def _value_prefix(self) -> None:
+        if self.frames and self.frames[-1][0] == "[":
+            if self.frames[-1][1]:
+                self._out(", ")
