+def emit_scanner_calls(
+    parser,
+    scanner: StreamingToolCallScanner,
+    state: dict,
+    *,
+    index_offset: int = 0,
+    require_arguments: bool = False,
+    name_override: str | None = None,
+    make_id=None,
+) -> list:
+    """Deltas for every call of ``scanner`` not yet sent, updating ``parser``'s
+    bookkeeping (``streamed_args_for_tool``, ``prev_tool_call_arr``,
+    ``current_tool_id``, ``current_tool_name_sent``).
+
+    ``state`` is a dict kept by the caller per scanner: ``sent`` (chunks handed
+    out per local call), ``named`` (name delta sent per local call) and
+    ``index`` (emitted index per local call; with ``require_arguments`` calls
+    that finish without arguments are skipped and indices stay compact, as the
+    non-streaming extractors of those formats do).
+    """
+    from vllm.entrypoints.openai.engine.protocol import DeltaFunctionCall, DeltaToolCall
+
+    sent = state.setdefault("sent", [])
+    named = state.setdefault("named", [])
+    index = state.setdefault("index", [])
+    deltas = []
+    for local, call in enumerate(scanner.calls):
+        while len(sent) <= local:
+            sent.append(0)
+            named.append(False)
+            index.append(None)
+        name = name_override if name_override is not None else call["name"]
+        if name is None:
+            break
+        if require_arguments and not call["args_started"]:
+            if call["done"]:
+                index[local] = -1  # skipped, like the non-streaming extractor
+                continue
+            break  # arguments may still come; nothing can be said yet
+        if index[local] == -1:
+            continue
+        if index[local] is None:
+            used = [i for i in index if i is not None and i >= 0]
+            index[local] = index_offset + (max(used) + 1 - index_offset if used else 0)
+        idx = index[local]
+        while len(parser.streamed_args_for_tool) <= idx:
+            parser.streamed_args_for_tool.append("")
+        while len(parser.prev_tool_call_arr) <= idx:
+            parser.prev_tool_call_arr.append({})
+        fragment, sent[local] = scanner.unsent(local, sent[local])
+        if fragment:
+            parser.streamed_args_for_tool[idx] += fragment
+        parser.current_tool_id = idx
+        if call["args_done"] and "arguments" not in parser.prev_tool_call_arr[idx]:
+            try:
+                arguments = json.loads(parser.streamed_args_for_tool[idx])
+            except ValueError:
+                arguments = parser.streamed_args_for_tool[idx]
+            parser.prev_tool_call_arr[idx] = {"name": name, "arguments": arguments}
+        elif not parser.prev_tool_call_arr[idx]:
+            parser.prev_tool_call_arr[idx] = {"name": name}
+        if not named[local]:
+            named[local] = True
+            parser.current_tool_name_sent = True
+            deltas.append(
+                DeltaToolCall(
+                    index=idx,
+                    type="function",
+                    id=make_id() if make_id else None,
+                    function=DeltaFunctionCall(name=name, arguments=fragment or None).model_dump(
+                        exclude_none=True
+                    ),
+                )
+            )
+        elif fragment:
+            deltas.append(
+                DeltaToolCall(
+                    index=idx,
+                    function=DeltaFunctionCall(arguments=fragment).model_dump(exclude_none=True),
+                )
+            )
+    return deltas
+
