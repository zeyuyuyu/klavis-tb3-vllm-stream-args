+    def _flush(self, plain: list[str]) -> None:
+        if not plain:
+            return
+        s = "".join(plain)
+        plain.clear()
+        if self.render and not self.str_key:
+            self._out(self._dumps(s)[1:-1])
+        else:
+            self.str_buf.append(s)
