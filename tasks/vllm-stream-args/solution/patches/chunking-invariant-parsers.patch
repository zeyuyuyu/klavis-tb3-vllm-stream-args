+    def _maybe_start_scalar_arguments(self) -> None:
+        if not self.render and self._at_call_level() and self._key_starts_arguments():
+            self.render = True
+            self.arg_depth = self.depth
+            self.frames = []
+            self.calls[-1]["args_started"] = True
+            self.pending_key = None
+
+    def _args_done(self) -> None:
+        self.render = False
+        self.frames = []
+        self.arg_depth = None
+        self.calls[-1]["args_done"] = True
+
+    def _open(self, c: str) -> None:
