+def _stream_json_array(parser, previous_text, current_text, *, start_token, end_token=None,
+                       argument_keys=("arguments",), content_before=True, require_arguments=False,
+                       name_is_key=False, start_in_array=False, make_id=None, trailing_content=False):
+    """One JSON array of tool-call objects after ``start_token`` (up to ``end_token``)."""
+    st = getattr(parser, "_stream", None)
+    if not previous_text or st is None:
+        st = _reset_stream(parser, {"scanner": None, "state": {}, "content_sent": 0, "body": None, "end": None})
+    n = len(current_text)
+    content = None
+    if st["body"] is None:
+        idx = current_text.find(start_token, max(0, len(previous_text) - len(start_token)))
+        if idx == -1:
+            upto = n - partial_tag_overlap(current_text, start_token)
+            if content_before and upto > st["content_sent"]:
+                content = current_text[st["content_sent"] : upto]
+                st["content_sent"] = upto
+            return DeltaMessage(content=content) if content else None
+        if content_before and idx > st["content_sent"]:
+            content = current_text[st["content_sent"] : idx]
+            st["content_sent"] = idx
+        st["body"] = idx + len(start_token)
+        sc = StreamingToolCallScanner(argument_keys, name_is_key=name_is_key, start_in_array=start_in_array)
+        sc.pos = st["body"]
+        st["scanner"] = sc
+    if end_token and st["end"] is None:
+        end = find_new(current_text, end_token, st["body"], len(previous_text))
+        if end != -1:
+            st["end"] = end
+    st["scanner"].feed(current_text, st["end"])
+    deltas = emit_scanner_calls(parser, st["scanner"], st["state"], require_arguments=require_arguments, make_id=make_id)
+    if trailing_content and st["end"] is not None:
+        after = st["end"] + len(end_token)
+        if st.get("after_sent") is None:
+            st["after_sent"] = after
+        if n > st["after_sent"]:
+            content = (content or "") + current_text[st["after_sent"]:]
+            st["after_sent"] = n
+    if not deltas and not content:
+        return None
+    return DeltaMessage(content=content, tool_calls=deltas)
