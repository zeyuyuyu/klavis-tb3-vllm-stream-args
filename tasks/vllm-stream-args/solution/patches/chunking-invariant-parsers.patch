+# --- chunking-invariant streaming support -------------------------------------
+#
+# ``StreamingToolCallScanner`` lets a parser stream the arguments of JSON tool
+# calls so that the client-side concatenation of every delta is exactly
+# ``json.dumps(json.loads(raw), ensure_ascii=False)`` whatever way the model
+# output was split into deltas, while each delta still goes out as soon as the
+# text that determines it has arrived.  It works on the raw model text, never
+# on a re-parsed and re-serialised snapshot, so nothing already sent can change
+# afterwards, and it resumes where it stopped, so a stream costs O(len) in
+# total rather than O(len) per delta.
+
+_JSON_WS = " \t\n\r"
+_NUM_CHARS = frozenset("+-0123456789.eE")
+_LITERALS = {"true": True, "false": False, "null": None}
+_SIMPLE_ESCAPES = {"n": "\n", "t": "\t", "r": "\r", "b": "\b", "f": "\f"}
+
+
+def _escape_string_body(value: str) -> str:
+    return json.dumps(value, ensure_ascii=False)[1:-1]
+
+
+class StreamingToolCallScanner:
+    """Incremental scanner over the JSON payload of a tool-call stream.
+
+    ``feed(text, end)`` is given the payload text seen so far (append-only; the
+    scanner only reads ``text[self.pos:end]``).  For each tool call found so
+    far it keeps the ``name`` once its string is complete and an append-only
+    list of canonical ``args`` chunks: the canonical rendering of the arguments
+    value as far as it is determined.  Unfinished strings are rendered up to
+    the last character that can no longer change (an incomplete escape or a
+    high surrogate waiting for its partner is held back), numbers wait for the
+    character that terminates them, object keys wait for their closing quote.
+    The payload may be one call object or an array of them.
+    """
+
+    def __init__(self, argument_keys=("arguments",)):
+        self.argument_keys = tuple(argument_keys)
+        self.calls: list[dict] = []
+        self.pos = 0
+        self.depth = 0
+        self.done = False
+        self.broken = False
+        self.call_depth: int | None = None
+        self.pending_key: str | None = None
+        self.prev = None  # previous structural event: '{' '[' ',' ':' 'key' 'value'
+        self.render = False
+        self.arg_depth: int | None = None
+        self.frames: list[list] = []  # [kind, items, expecting_key]
+        self.mode: str | None = None  # None | 'str' | 'num' | 'lit'
+        self.str_key = False
+        self.str_buf: list[str] = []
+        self.esc = ""
+        self.hi: int | None = None
+        self.buf = ""
+
+    # -- public ---------------------------------------------------------------
+    def feed(self, text: str, end: int | None = None) -> None:
+        if self.done or self.broken:
+            return
+        i = self.pos
+        n = len(text) if end is None else end
+        while i < n:
+            if self.mode == "str":
+                i = self._feed_string(text, i, n)
+                continue
+            c = text[i]
+            if self.mode == "num":
+                if c in _NUM_CHARS:
+                    self.buf += c
+                    i += 1
+                    continue
+                self._end_number()
+                continue
+            if self.mode == "lit":
+                self.buf += c
+                i += 1
+                if self.buf in _LITERALS:
+                    self._end_literal()
+                elif not any(w.startswith(self.buf) for w in _LITERALS):
+                    self.broken = True
+                    break
+                continue
+            if c in _JSON_WS:
+                i += 1
+            elif c == "{" or c == "[":
+                self._open(c)
+                i += 1
+            elif c == "}" or c == "]":
+                self._close(c)
+                i += 1
+                if self.done:
+                    break
+            elif c == ",":
+                if self.render and self.frames and self.frames[-1][0] == "{":
+                    self.frames[-1][2] = True
+                self.prev = ","
+                i += 1
+            elif c == ":":
+                self.prev = ":"
+                i += 1
+            elif c == '"':
+                self._begin_string()
+                i += 1
+            elif c in "-0123456789":
+                self._maybe_start_scalar_arguments()
+                self.mode = "num"
+                self.buf = c
+                i += 1
+            elif c in "tfn":
+                self._maybe_start_scalar_arguments()
+                self.mode = "lit"
+                self.buf = c
+                i += 1
+            else:
+                self.broken = True
+                break
+        self.pos = i
+
+    def unsent(self, index: int, sent_chunks: int) -> tuple[str, int]:
+        """Canonical argument text of call ``index`` not yet handed out."""
+        chunks = self.calls[index]["args"]
+        if sent_chunks >= len(chunks):
+            return "", sent_chunks
+        return "".join(chunks[sent_chunks:]), len(chunks)
+
+    # -- structure ------------------------------------------------------------
+    def _new_call(self) -> None:
+        self.calls.append(
+            {"name": None, "args": [], "args_started": False, "args_done": False, "done": False}
+        )
+
+    def _out(self, s: str) -> None:
+        self.calls[-1]["args"].append(s)
+
+    def _value_prefix(self) -> None:
+        if self.frames and self.frames[-1][0] == "[":
+            if self.frames[-1][1]:
+                self._out(", ")
+            self.frames[-1][1] += 1
+
+    def _at_call_level(self) -> bool:
+        return self.call_depth is not None and self.depth == self.call_depth
+
+    def _maybe_start_scalar_arguments(self) -> None:
+        if (
+            not self.render
+            and self._at_call_level()
+            and self.pending_key in self.argument_keys
+            and self.prev == ":"
+        ):
+            self.render = True
+            self.arg_depth = self.depth
+            self.frames = []
+            self.calls[-1]["args_started"] = True
+            self.pending_key = None
+
+    def _args_done(self) -> None:
+        self.render = False
+        self.frames = []
+        self.arg_depth = None
+        self.calls[-1]["args_done"] = True
+
+    def _open(self, c: str) -> None:
+        self.depth += 1
+        if self.render:
+            self._value_prefix()
+            self._out(c)
+            self.frames.append([c, 0, c == "{"])
+        elif c == "{" and self.call_depth is None and self.depth <= 2:
+            self.call_depth = self.depth
+            self._new_call()
+        elif (
+            self.call_depth is not None
+            and self.depth == self.call_depth + 1
+            and self.pending_key in self.argument_keys
+            and self.prev == ":"
+        ):
+            self.render = True
+            self.arg_depth = self.depth - 1
+            self.frames = [[c, 0, c == "{"]]
+            self.calls[-1]["args_started"] = True
+            self.pending_key = None
+            self._out(c)
+        elif self.call_depth is not None and self.depth == self.call_depth + 1:
+            self.pending_key = None
+        self.prev = c
+
+    def _close(self, c: str) -> None:
+        if self.render:
+            self._out(c)
+            if self.frames:
+                self.frames.pop()
+        self.depth -= 1
+        if self.render and self.depth == self.arg_depth:
+            self._args_done()
+        if self.call_depth is not None and self.depth < self.call_depth:
+            self.calls[-1]["done"] = True
+            self.call_depth = None
+            self.pending_key = None
+        if self.depth <= 0:
+            self.done = True
+        self.prev = "value"
+
+    def _call_level_scalar(self, kind: str, value) -> None:
+        if not self._at_call_level():
+            return
+        if kind == "str" and self.prev in ("{", ","):
+            self.pending_key = value
+            self.prev = "key"
+            return
+        if self.pending_key == "name" and kind == "str":
+            self.calls[-1]["name"] = value
+        self.pending_key = None
+
+    # -- scalars --------------------------------------------------------------
+    def _end_number(self) -> None:
+        self.mode = None
+        try:
+            value = json.loads(self.buf)
+        except ValueError:
+            self.broken = True
+            return
+        self._scalar(value)
+
+    def _end_literal(self) -> None:
+        self.mode = None
+        self._scalar(_LITERALS[self.buf])
+
+    def _scalar(self, value) -> None:
+        if self.render:
+            self._value_prefix()
+            self._out(json.dumps(value, ensure_ascii=False))
+            if not self.frames:
+                self._args_done()
+        else:
+            self._call_level_scalar("num", value)
+        if self.prev != "key":
+            self.prev = "value"
+
+    def _begin_string(self) -> None:
+        self._maybe_start_scalar_arguments()
+        self.mode = "str"
+        self.str_buf = []
+        self.esc = ""
+        self.hi = None
+        self.str_key = bool(self.render and self.frames and self.frames[-1][0] == "{" and self.frames[-1][2])
+        if self.render and not self.str_key:
+            self._value_prefix()
+            self._out('"')
+
+    def _feed_string(self, text: str, i: int, n: int) -> int:
+        plain: list[str] = []
+        while i < n:
+            c = text[i]
+            if self.esc:
+                self.esc += c
+                i += 1
+                e = self.esc
+                if e[1] != "u":
+                    self.esc = ""
+                    self._decoded(_SIMPLE_ESCAPES.get(e[1], e[1]), plain)
+                elif len(e) == 6:
+                    self.esc = ""
+                    try:
+                        code = int(e[2:], 16)
+                    except ValueError:
+                        self.broken = True
+                        return n
+                    if self.hi is not None and 0xDC00 <= code <= 0xDFFF:
+                        plain.append(chr(0x10000 + ((self.hi - 0xD800) << 10) + (code - 0xDC00)))
+                        self.hi = None
+                    elif 0xD800 <= code <= 0xDBFF:
+                        if self.hi is not None:
+                            plain.append(chr(self.hi))
+                        self.hi = code
+                    else:
+                        self._decoded(chr(code), plain)
+                continue
+            if c == "\\":
+                self.esc = c
+                i += 1
+                continue
+            if c == '"':
+                i += 1
+                if self.hi is not None:
+                    plain.append(chr(self.hi))
+                    self.hi = None
+                self._flush(plain)
+                self._end_string()
+                return i
+            self._decoded(c, plain)
+            i += 1
+        self._flush(plain)
+        return i
+
+    def _decoded(self, ch: str, plain: list[str]) -> None:
+        if self.hi is not None:
+            plain.append(chr(self.hi))
+            self.hi = None
+        plain.append(ch)
+
+    def _flush(self, plain: list[str]) -> None:
+        if not plain:
+            return
+        s = "".join(plain)
+        plain.clear()
+        if self.render and not self.str_key:
+            self._out(_escape_string_body(s))
+        else:
+            self.str_buf.append(s)
+
+    def _end_string(self) -> None:
+        self.mode = None
+        s = "".join(self.str_buf)
+        self.str_buf = []
+        if self.render:
+            if self.str_key:
+                fr = self.frames[-1]
+                self._out((", " if fr[1] else "") + json.dumps(s, ensure_ascii=False) + ": ")
+                fr[1] += 1
+                fr[2] = False
+                self.prev = "key"
+                return
+            self._out('"')
+            if not self.frames:
+                self._args_done()
+            self.prev = "value"
+            return
+        self._call_level_scalar("str", s)
+        if self.prev != "key":
+            self.prev = "value"
+
+
+def canonical_json_prefix(text: str) -> str:
+    """Canonical rendering of the (possibly unfinished) JSON value in ``text``.
+
+    For every prefix ``p`` of a valid JSON document ``t`` the result for ``p``
+    is a prefix of the result for ``t``, and the result for ``t`` equals
+    ``json.dumps(json.loads(t), ensure_ascii=False)``.
+    """
+    scanner = StreamingToolCallScanner(("value",))
+    scanner.feed('{"value":' + text)
+    if not scanner.calls:
+        return ""
+    return "".join(scanner.calls[0]["args"])
