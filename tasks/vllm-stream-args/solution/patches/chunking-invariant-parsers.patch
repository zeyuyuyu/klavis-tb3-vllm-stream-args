+def _emit_calls(parser, scanner, content, sent_chunks, names_sent):
+    """Turn the scanner's state into the deltas not yet sent."""
+    deltas: list[DeltaToolCall] = []
+    for idx, call in enumerate(scanner.calls):
+        name = call["name"]
+        if name is None:
+            break
+        while len(parser.streamed_args_for_tool) <= idx:
+            parser.streamed_args_for_tool.append("")
+        while len(parser.prev_tool_call_arr) <= idx:
+            parser.prev_tool_call_arr.append({})
+        while len(sent_chunks) <= idx:
+            sent_chunks.append(0)
+            names_sent.append(False)
+        fragment, sent_chunks[idx] = scanner.unsent(idx, sent_chunks[idx])
+        if fragment:
+            parser.streamed_args_for_tool[idx] += fragment
+        parser.current_tool_id = idx
+        if call["args_done"] and "arguments" not in parser.prev_tool_call_arr[idx]:
+            try:
+                arguments = json.loads(parser.streamed_args_for_tool[idx])
+            except ValueError:
+                arguments = {}
+            parser.prev_tool_call_arr[idx] = {"name": name, "arguments": arguments}
+        elif not parser.prev_tool_call_arr[idx]:
+            parser.prev_tool_call_arr[idx] = {"name": name}
+        if not names_sent[idx]:
+            names_sent[idx] = True
+            parser.current_tool_name_sent = True
+            deltas.append(
+                DeltaToolCall(
+                    index=idx,
+                    type="function",
+                    id=make_tool_call_id(),
+                    function=DeltaFunctionCall(
+                        name=name, arguments=fragment or None
+                    ).model_dump(exclude_none=True),
+                )
+            )
